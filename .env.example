# ══════════════════════════════════════════════════════════════════════════
# polyweather environment -- ported from hermes/.env.example, cut down to
# what this codebase ACTUALLY READS.
#
# NOTHING IN THIS REPO LOADS THIS FILE.
# There is no python-dotenv dependency and no load_dotenv() call anywhere
# (grep it). Copying this to .env therefore does NOT put these values in
# the environment on its own. Two ways to actually get them in:
#
#   local / manual runs:
#       set -a; . ./.env; set +a          # then: python scheduler.py ...
#
#   the EC2 daemon:
#       add an EnvironmentFile= line to the [Service] block of
#       /etc/systemd/system/polyweather.service, then daemon-reload.
#       deploy/deploy_daemon.sh writes that unit and deliberately does NOT
#       add one -- see the comment above ExecStart. Adding it is a manual
#       edit, and the next deploy will rewrite the unit and drop it again,
#       so use a drop-in (systemctl edit polyweather) rather than editing
#       the generated file.
#
# COMMENTS GO ON THEIR OWN LINE. NEVER "KEY=value # comment".
# systemd's EnvironmentFile= parser does not support inline comments --
# everything after "=" becomes part of the literal value, comment text
# included (systemd issue #12527). hermes could half-survive this because
# its local runs went through python-dotenv, which DOES strip them; here
# systemd's parser is the only one that will ever read this file, so a
# trailing comment is a silent corruption with no fallback.
# ══════════════════════════════════════════════════════════════════════════

# ── Polymarket credentials (clients/wallet_client.py) ──────────────────────
# These three are the ONLY environment variables this codebase reads.
# Everything else that lives in hermes' .env is a config.py constant here --
# see the bottom of this file.

# EOA private key controlling the account.
# From polymarket.com/settings -> Export Private Key.
POLYMARKET_PRIVATE_KEY=0x...

# Address that actually holds the funds (the proxy / Magic wallet).
# From polymarket.com/settings. NOT the same as the private key's own
# address for email/Magic accounts.
POLYMARKET_FUNDER=0x...

# The second of the two gates. No real order is submitted unless BOTH this
# is exactly "true" AND the station's execution mode is "live" (scheduler
# also requires --mode live and --i-understand-this-spends-real-money).
# Leave unset for simulation/paper: every step but the final submit still
# runs. check_open_orders.py does NOT need this -- reading orders is not
# submitting one.
POLYMARKET_LIVE_TRADING=false

# ── Signature type -- READ THIS BEFORE THE FIRST LIVE ORDER ────────────────
# 0 = EOA/MetaMask, 1 = POLY_PROXY (email/Magic), 3 = POLY_1271 (deposit
# wallet, provisioned via hermes' setup_deposit_wallet.py).
#
# The two codebases on this machine disagree, and this one has never placed
# a live order to settle it:
#   - wallet_client.py defaults to 1, citing py-clob-client-v2 issue #70
#     (2026-05-19): type 3 fails for new accounts, L1 auth binds the API key
#     to the EOA instead of the deposit wallet.
#   - hermes' .env.example (edited 2026-07-19, two months later) says 0 and 1
#     are BOTH rejected since the CLOB V2 go-live -- "maker address not
#     allowed, please use the deposit wallet flow" -- and ships 3.
#
# Unset means 1, i.e. today's behaviour, unchanged. If the first live order
# is rejected with "maker address not allowed", hermes is right: set 3 here
# rather than editing wallet_client.py. That path also needs the deposit
# wallet to exist first (hermes' setup_deposit_wallet.py + builder creds);
# nothing in this repo provisions one.
POLYMARKET_SIGNATURE_TYPE=1

# ══════════════════════════════════════════════════════════════════════════
# DELIBERATELY NOT PORTED
# ══════════════════════════════════════════════════════════════════════════
#
# CLOB_API_KEY / CLOB_SECRET / CLOB_PASS_PHRASE
#   Not needed. hermes passes creds= into ClobClient and runs
#   generate_creds.py to mint them. get_client() here passes no creds and
#   calls create_or_derive_api_key(), which derives L2 credentials from the
#   private key on each start. Setting these would have no effect.
#
# CLOB_API_HOST
#   Hardcoded as wallet_client.CLOB_HOST.
#
# BUILDER_API_KEY / BUILDER_SECRET / BUILDER_PASS_PHRASE / RELAYER_URL
#   Only hermes' setup_deposit_wallet.py uses these. No equivalent here.
#
# DB_PATH
#   config.DB_PATH -- data/polyweather.sqlite3, relative to the package dir.
#
# Every trading knob. hermes tunes via env; this codebase tunes in config.py,
# where each value sits next to the reasoning that produced it. Nearest
# equivalents, so a hermes .env is not mistaken for a way to steer this bot:
#
#   EDGE_THRESHOLD           -> config.MIN_ABS_RAW_EDGE (0.03)
#   MAX_EDGE_MAGNITUDE       -> config.MAX_PLAUSIBLE_RAW_EDGE (0.25)
#   MIN_ENTRY_PRICE          -> config.EV_MIN_PRICE_SCREEN / LOTTERY_PRICE_THRESHOLD
#                               (and config.MAX_ENTRY_PRICE at the top end)
#   STOP_LOSS_PCT            -> config.STOP_LOSS_PCT (0.30)
#   TRAIL_PCT                -> config.TRAILING_STOP_PCT (0.15), gated by
#                               config.TRAILING_STOP_ACTIVATION_PCT
#   KELLY_FRACTION           -> config.KELLY_FRACTION (0.25)
#   MAX_VAULT_ALLOCATION     -> config.BANKROLL_USD (1000.0)
#   VALIDATION_POSITION_USD  -> config.LIVE_TRADE_SIZE_USD (1.0)
#   MIN_POSITION_USD         -> no direct equivalent; the floor is the
#                               exchange minimum, handled in build_entry_order()
#   MAX_SHARES_PER_POSITION  -> no equivalent; bounded in dollars instead via
#                               config.MAX_POSITION_USD and
#                               config.LIVE_MAX_TOTAL_EXPOSURE_USD
#
# NOTE the exit thresholds are not comparable numbers even where the names
# match: hermes' are percentages OF ENTRY PRICE, this codebase's are
# percentages of the RISK UNIT, min(entry, 1-entry). 0.30 here is not three
# times looser than hermes' 0.10.
